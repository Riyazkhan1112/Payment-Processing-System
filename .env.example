PORT=3000
NODE_ENV=development

# Third-party Gateway
GATEWAY_BASE_URL=https://api.sandbox.paymentgateway.com
GATEWAY_API_KEY=test_api_key_12345
GATEWAY_TIMEOUT=5000
SIMULATE_MODE=true

# Retry Config
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=1000
RETRY_MAX_DELAY=10000

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100
